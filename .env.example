# ===========================================================================
# Sarvam Voice AI — Environment Configuration Matrix
# ===========================================================================
# Copy this file to .env.local for local development.
# For Vercel production deployments, configure these in the Vercel Dashboard.
# NEVER commit real secret values to Git.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC DOMAIN
# ---------------------------------------------------------------------------
# [REQUIRED, PUBLIC] Canonical HTTPS origin of your deployed SaaS.
# In local dev: http://localhost:3000
# In production on Vercel: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, AUTH, STORAGE)
# ---------------------------------------------------------------------------
# [REQUIRED, PUBLIC] Supabase project REST & Auth URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# [REQUIRED, PUBLIC] Supabase publishable anonymous key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [REQUIRED, SERVER-ONLY, SECRET] Supabase service role key (bypasses RLS)
# Used only in server routes, webhooks, and background administration.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 3. AUTHENTICATION & API KEY SECURITY
# ---------------------------------------------------------------------------
# [REQUIRED IN PROD, SERVER-ONLY, SECRET] Minimum 32-character random pepper
# used for cryptographic HMAC-SHA256 hashing of developer API keys.
AUTH_API_KEY_PEPPER=

# [REQUIRED IN PROD, SERVER-ONLY] Must be set to 'false' in production.
# When 'true' (local dev only), allows one-click sandbox sign-in.
AUTH_DEMO_MODE=false

# [OPTIONAL, PUBLIC] Show the "Phone OTP" sign-in tab. Requires an SMS
# provider configured in Supabase (Authentication -> Sign In / Providers -> Phone).
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

# Optional dev-only credentials for demo mode:
AUTH_DEMO_EMAIL=demo@local.sarvam.test
AUTH_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# 4. SARVAM VOICE AGENTS (TELEPHONY & OUTBOUND SCHEDULING)
# ---------------------------------------------------------------------------
# [REQUIRED, SERVER-ONLY, SECRET] Dedicated Voice Agents key from indus.sarvam.ai
# (Settings -> API Key). This is DIFFERENT from the Model API key.
SARVAM_VOICE_AGENTS_API_KEY=

# [OPTIONAL, SERVER-ONLY] Model API key (api.sarvam.ai) for STT/TTS calls.
SARVAM_API_KEY=

# [REQUIRED, SERVER-ONLY] Base scheduling host (default: https://apps.sarvam.ai)
SARVAM_BASE_URL=https://apps.sarvam.ai

# [REQUIRED, SERVER-ONLY] Organization & Workspace IDs from indus.sarvam.ai
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=

# [REQUIRED, SERVER-ONLY] Committed Agent App ID and Version
SARVAM_AGENT_APP_ID=
SARVAM_AGENT_APP_VERSION=1

# [REQUIRED, SERVER-ONLY] Telephony connection ID (Deploy -> Phone Numbers)
SARVAM_CONNECTION_ID=

# [OPTIONAL, SERVER-ONLY] E.164 dialer numbers registered with connection
SARVAM_DIALER_PHONE_NUMBERS=+91XXXXXXXXXX

# Dial rate and campaign time-to-live
SARVAM_ATTEMPTS_PER_SECOND=1
SARVAM_CAMPAIGN_TTL_DAYS=7

# Allowed contact variables streamed in cohorts (comma-separated)
SARVAM_COHORT_VARIABLES=customer_name

# [REQUIRED, SERVER-ONLY, SECRET] Random shared token for webhook URL correlation
SARVAM_WEBHOOK_TOKEN=

# [OPTIONAL, SERVER-ONLY, SECRET] HMAC-SHA256 callback signing secret (if enabled)
SARVAM_WEBHOOK_SECRET=

# [REQUIRED IN PROD, SERVER-ONLY] Must be 'false' in production for live calls.
SARVAM_MOCK_MODE=false

# ---------------------------------------------------------------------------
# 5. RAZORPAY BILLING & GST TAX ENGINE
# ---------------------------------------------------------------------------
# [REQUIRED IN PROD, SERVER-ONLY] Razorpay API Key ID (rzp_live_... or rzp_test_...)
RAZORPAY_KEY_ID=

# [REQUIRED IN PROD, SERVER-ONLY, SECRET] Razorpay API Key Secret
RAZORPAY_KEY_SECRET=

# [REQUIRED IN PROD, SERVER-ONLY, SECRET] Secret configured in Razorpay Webhooks dashboard
RAZORPAY_WEBHOOK_SECRET=

# [REQUIRED IN PROD, SERVER-ONLY] Must be 'false' in production for real debits.
RAZORPAY_MOCK_MODE=false

# Indian GST Tax Engine Configuration
# Platform origin 2-digit state code (e.g. 27 for Maharashtra, 29 for Karnataka)
PLATFORM_STATE_CODE=27

# Standard GST percentage applied to software subscriptions (18.0%)
DEFAULT_GST_RATE=18.0
